{
  "$defs": {
    "BlobRef": {
      "properties": {
        "hash": { "type": "string" },
        "mode": { "type": "string" },
        "size": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": ["hash", "size", "mode"],
      "type": "object"
    },
    "CaptureRequest": {
      "properties": {
        "base": { "type": ["string", "null"] },
        "includeUntracked": { "type": "boolean" },
        "repositoryId": { "type": "string" },
        "scope": { "$ref": "#/$defs/Scope" },
        "target": { "type": ["string", "null"] }
      },
      "required": ["repositoryId", "scope", "includeUntracked"],
      "type": "object"
    },
    "Change": {
      "properties": {
        "after": {
          "anyOf": [{ "$ref": "#/$defs/BlobRef" }, { "type": "null" }]
        },
        "before": {
          "anyOf": [{ "$ref": "#/$defs/BlobRef" }, { "type": "null" }]
        },
        "binary": { "type": "boolean" },
        "id": { "type": "string" },
        "layer": { "type": "string" },
        "passages": { "items": { "$ref": "#/$defs/Passage" }, "type": "array" },
        "path": { "type": "string" },
        "previousPath": { "type": ["string", "null"] },
        "untracked": { "default": false, "type": "boolean" }
      },
      "required": ["id", "path", "layer", "binary", "passages"],
      "type": "object"
    },
    "CodeAnchor": {
      "properties": {
        "changeId": { "type": "string" },
        "passageId": { "type": "string" },
        "snapshotId": { "type": "string" }
      },
      "required": ["snapshotId", "changeId", "passageId"],
      "type": "object"
    },
    "ContentSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "git", "type": "string" },
            "oid": { "type": "string" },
            "size": { "format": "uint32", "minimum": 0, "type": "integer" }
          },
          "required": ["kind", "oid", "size"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "pack", "type": "string" },
            "path": { "type": "string" },
            "size": { "format": "uint32", "minimum": 0, "type": "integer" }
          },
          "required": ["kind", "path", "size"],
          "type": "object"
        }
      ]
    },
    "Decision": {
      "properties": {
        "author": { "default": "human:legacy", "type": "string" },
        "createdAt": { "type": "string" },
        "fingerprint": { "type": "string" },
        "id": { "type": "string" },
        "state": { "$ref": "#/$defs/DecisionState" },
        "target": { "$ref": "#/$defs/DecisionTarget" }
      },
      "required": ["id", "target", "state", "fingerprint", "createdAt"],
      "type": "object"
    },
    "DecisionState": { "enum": ["examined", "validated"], "type": "string" },
    "DecisionTarget": {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "step", "type": "string" },
            "stepId": { "type": "string" }
          },
          "required": ["kind", "stepId"],
          "type": "object"
        },
        {
          "properties": {
            "fileId": { "type": "string" },
            "kind": { "const": "file", "type": "string" }
          },
          "required": ["kind", "fileId"],
          "type": "object"
        }
      ]
    },
    "DocumentReference": {
      "additionalProperties": false,
      "properties": {
        "endLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "explanation": { "type": "string" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "sourceId": { "type": "string" },
        "startLine": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": [
        "id",
        "label",
        "explanation",
        "sourceId",
        "startLine",
        "endLine"
      ],
      "type": "object"
    },
    "DocumentTerm": {
      "additionalProperties": false,
      "properties": {
        "context": { "type": "string" },
        "definition": { "type": "string" },
        "id": { "type": "string" },
        "term": { "type": "string" }
      },
      "required": ["id", "term", "definition", "context"],
      "type": "object"
    },
    "ExplanationDocument": {
      "properties": {
        "createdAt": { "type": "string" },
        "fingerprint": { "type": "string" },
        "id": { "type": "string" },
        "language": { "type": "string" },
        "occurrences": {
          "items": { "$ref": "#/$defs/TermOccurrence" },
          "type": "array"
        },
        "path": { "type": "string" },
        "repositoryId": { "type": "string" },
        "sections": {
          "items": { "$ref": "#/$defs/ExplanationSection" },
          "type": "array"
        },
        "snapshotId": { "type": "string" }
      },
      "required": [
        "id",
        "repositoryId",
        "snapshotId",
        "path",
        "fingerprint",
        "language",
        "sections",
        "occurrences",
        "createdAt"
      ],
      "type": "object"
    },
    "ExplanationSection": {
      "properties": {
        "body": { "type": "string" },
        "endLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "id": { "type": "string" },
        "startLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "title": { "type": "string" }
      },
      "required": ["id", "title", "body", "startLine", "endLine"],
      "type": "object"
    },
    "GlossaryTerm": {
      "properties": {
        "aliases": { "items": { "type": "string" }, "type": "array" },
        "archived": { "type": "boolean" },
        "id": { "type": "string" },
        "senses": { "items": { "$ref": "#/$defs/Sense" }, "type": "array" },
        "term": { "type": "string" }
      },
      "required": ["id", "term", "aliases", "senses", "archived"],
      "type": "object"
    },
    "LevelDocuments": {
      "additionalProperties": false,
      "properties": {
        "beginner": { "$ref": "#/$defs/ReviewDocument" },
        "developer": { "$ref": "#/$defs/ReviewDocument" },
        "glossary": {
          "default": [],
          "items": { "$ref": "#/$defs/DocumentTerm" },
          "type": "array"
        },
        "intermediate": { "$ref": "#/$defs/ReviewDocument" }
      },
      "required": ["beginner", "intermediate", "developer"],
      "type": "object"
    },
    "OnboardingStep": {
      "properties": {
        "endLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "explanation": { "type": "string" },
        "fingerprint": { "type": "string" },
        "id": { "type": "string" },
        "path": { "type": "string" },
        "quote": { "type": "string" },
        "startLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "title": { "type": "string" },
        "visited": { "default": false, "type": "boolean" }
      },
      "required": [
        "id",
        "title",
        "explanation",
        "path",
        "startLine",
        "endLine",
        "quote",
        "fingerprint"
      ],
      "type": "object"
    },
    "Passage": {
      "properties": {
        "fingerprint": { "type": "string" },
        "id": { "type": "string" },
        "newLines": { "format": "uint32", "minimum": 0, "type": "integer" },
        "newStart": { "format": "uint32", "minimum": 0, "type": "integer" },
        "oldLines": { "format": "uint32", "minimum": 0, "type": "integer" },
        "oldStart": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": [
        "id",
        "oldStart",
        "oldLines",
        "newStart",
        "newLines",
        "fingerprint"
      ],
      "type": "object"
    },
    "PreparationMode": { "enum": ["rev", "manual"], "type": "string" },
    "ProposalContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "topics", "type": "string" },
            "topics": { "items": { "$ref": "#/$defs/Topic" }, "type": "array" }
          },
          "required": ["kind", "topics"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "explanation", "type": "string" },
            "path": { "type": "string" },
            "sections": {
              "items": { "$ref": "#/$defs/ExplanationSection" },
              "type": "array"
            }
          },
          "required": ["kind", "path", "sections"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "glossary", "type": "string" },
            "terms": {
              "items": { "$ref": "#/$defs/GlossaryTerm" },
              "type": "array"
            }
          },
          "required": ["kind", "terms"],
          "type": "object"
        }
      ]
    },
    "PseudoTranslationInfo": {
      "properties": {
        "available": { "type": "boolean" },
        "sourceHash": { "type": "string" },
        "sourceId": { "type": "string" },
        "unavailableReason": { "type": ["string", "null"] }
      },
      "required": ["sourceId", "sourceHash", "available"],
      "type": "object"
    },
    "ReadingContext": { "enum": ["guided", "files"], "type": "string" },
    "ReadingPosition": {
      "properties": {
        "changeId": { "type": ["string", "null"] },
        "context": { "$ref": "#/$defs/ReadingContext" },
        "fileId": { "type": ["string", "null"] },
        "line": { "format": "uint32", "minimum": 0, "type": "integer" },
        "passageId": { "type": ["string", "null"] },
        "scrollTop": { "format": "double", "type": "number" },
        "split": { "type": "boolean" },
        "stepId": { "type": ["string", "null"] }
      },
      "required": ["context", "line", "scrollTop", "split"],
      "type": "object"
    },
    "ReviewDocument": {
      "additionalProperties": false,
      "properties": {
        "body": { "type": "string" },
        "readingSeconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "references": {
          "items": { "$ref": "#/$defs/DocumentReference" },
          "type": "array"
        },
        "termAliases": {
          "additionalProperties": { "type": "string" },
          "default": {},
          "type": "object"
        },
        "terms": {
          "items": { "$ref": "#/$defs/DocumentTerm" },
          "type": "array"
        }
      },
      "required": ["body", "references", "terms", "readingSeconds"],
      "type": "object"
    },
    "ReviewFile": {
      "properties": {
        "changeIds": { "items": { "type": "string" }, "type": "array" },
        "hasDocuments": { "type": "boolean" },
        "id": { "type": "string" },
        "path": { "type": "string" },
        "pseudocodeSelected": { "default": null, "type": ["boolean", "null"] },
        "pseudocodeSkipReason": { "default": null, "type": ["string", "null"] },
        "translations": {
          "items": { "$ref": "#/$defs/PseudoTranslationInfo" },
          "type": "array"
        }
      },
      "required": ["id", "path", "changeIds", "hasDocuments", "translations"],
      "type": "object"
    },
    "ReviewMode": { "enum": ["guided", "manual"], "type": "string" },
    "Scope": {
      "enum": ["local", "staged", "unstaged", "commit", "range"],
      "type": "string"
    },
    "Sense": {
      "properties": {
        "description": { "type": "string" },
        "id": { "type": "string" }
      },
      "required": ["id", "description"],
      "type": "object"
    },
    "SnapshotFile": {
      "properties": {
        "content": { "$ref": "#/$defs/BlobRef" },
        "path": { "type": "string" }
      },
      "required": ["path", "content"],
      "type": "object"
    },
    "Step": {
      "properties": {
        "anchors": {
          "items": { "$ref": "#/$defs/CodeAnchor" },
          "type": "array"
        },
        "documents": { "$ref": "#/$defs/LevelDocuments" },
        "id": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "title", "documents", "anchors"],
      "type": "object"
    },
    "StoredStep": {
      "properties": {
        "anchors": {
          "items": { "$ref": "#/$defs/CodeAnchor" },
          "type": "array"
        },
        "documentAsset": {
          "additionalProperties": false,
          "properties": {
            "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["path", "hash"],
          "type": "object"
        },
        "id": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "title", "anchors", "documentAsset"],
      "type": "object"
    },
    "StoredTopic": {
      "properties": {
        "brief": { "type": "string" },
        "id": { "type": "string" },
        "steps": { "items": { "$ref": "#/$defs/StoredStep" }, "type": "array" },
        "title": { "type": "string" }
      },
      "required": ["id", "title", "brief", "steps"],
      "type": "object"
    },
    "TermOccurrence": {
      "properties": {
        "description": { "type": ["string", "null"] },
        "id": { "type": "string" },
        "offset": { "format": "uint32", "minimum": 0, "type": "integer" },
        "quote": { "type": "string" },
        "sectionId": { "type": "string" },
        "senseId": { "type": ["string", "null"] },
        "termId": { "type": ["string", "null"] }
      },
      "required": ["id", "sectionId", "quote", "offset"],
      "type": "object"
    },
    "Topic": {
      "properties": {
        "brief": { "type": "string" },
        "id": { "type": "string" },
        "steps": { "items": { "$ref": "#/$defs/Step" }, "type": "array" },
        "title": { "type": "string" }
      },
      "required": ["id", "title", "brief", "steps"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "assetIndex": {
              "additionalProperties": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
                    "path": { "type": "string" }
                  },
                  "required": ["path", "hash"],
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            },
            "createdAt": { "type": "string" },
            "decisions": {
              "items": { "type": "string" },
              "type": "array",
              "uniqueItems": true
            },
            "examined": {
              "default": [],
              "items": { "type": "string" },
              "type": "array"
            },
            "files": {
              "items": { "$ref": "#/$defs/ReviewFile" },
              "type": "array"
            },
            "glossary": {
              "default": [],
              "items": { "$ref": "#/$defs/DocumentTerm" },
              "type": "array"
            },
            "id": { "type": "string" },
            "mode": { "$ref": "#/$defs/ReviewMode" },
            "position": {
              "$ref": "#/$defs/ReadingPosition",
              "default": {
                "changeId": null,
                "context": "guided",
                "fileId": null,
                "line": 0,
                "passageId": null,
                "scrollTop": 0,
                "split": false,
                "stepId": null
              }
            },
            "preparationId": { "type": ["string", "null"] },
            "previousSnapshotIds": {
              "items": { "type": "string" },
              "type": "array"
            },
            "repositoryId": { "type": "string" },
            "revision": { "format": "uint32", "minimum": 0, "type": "integer" },
            "snapshotId": { "type": "string" },
            "title": { "type": "string" },
            "topics": {
              "items": { "type": "string" },
              "type": "array",
              "uniqueItems": true
            },
            "updatedAt": { "type": "string" }
          },
          "required": [
            "id",
            "title",
            "repositoryId",
            "snapshotId",
            "previousSnapshotIds",
            "revision",
            "topics",
            "mode",
            "files",
            "decisions",
            "createdAt",
            "updatedAt",
            "assetIndex"
          ],
          "title": "Review",
          "type": "object"
        },
        "format": { "const": "reviewbox" },
        "id": { "pattern": "^[a-zA-Z0-9_@-]{1,160}$", "type": "string" },
        "kind": { "const": "review" },
        "version": { "const": 3 }
      },
      "required": ["format", "version", "kind", "id", "data"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "createdAt": { "type": "string" },
            "decisions": {
              "items": { "$ref": "#/$defs/Decision" },
              "type": "array"
            },
            "examined": {
              "default": [],
              "items": { "type": "string" },
              "type": "array"
            },
            "files": {
              "items": { "$ref": "#/$defs/ReviewFile" },
              "type": "array"
            },
            "glossary": {
              "default": [],
              "items": { "$ref": "#/$defs/DocumentTerm" },
              "type": "array"
            },
            "id": { "type": "string" },
            "mode": { "$ref": "#/$defs/ReviewMode" },
            "position": {
              "$ref": "#/$defs/ReadingPosition",
              "default": {
                "changeId": null,
                "context": "guided",
                "fileId": null,
                "line": 0,
                "passageId": null,
                "scrollTop": 0,
                "split": false,
                "stepId": null
              }
            },
            "preparationId": { "type": ["string", "null"] },
            "previousSnapshotIds": {
              "items": { "type": "string" },
              "type": "array"
            },
            "repositoryId": { "type": "string" },
            "revision": { "format": "uint32", "minimum": 0, "type": "integer" },
            "snapshotId": { "type": "string" },
            "title": { "type": "string" },
            "topics": {
              "items": { "$ref": "#/$defs/StoredTopic" },
              "type": "array"
            },
            "updatedAt": { "type": "string" }
          },
          "required": [
            "id",
            "title",
            "repositoryId",
            "snapshotId",
            "previousSnapshotIds",
            "revision",
            "topics",
            "mode",
            "files",
            "decisions",
            "createdAt",
            "updatedAt"
          ],
          "title": "Review",
          "type": "object"
        },
        "format": { "const": "reviewbox" },
        "id": { "pattern": "^[a-zA-Z0-9_@-]{1,160}$", "type": "string" },
        "kind": { "const": "review_history" },
        "version": { "const": 3 }
      },
      "required": ["format", "version", "kind", "id", "data"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "changes": {
              "items": { "$ref": "#/$defs/Change" },
              "type": "array"
            },
            "createdAt": { "type": "string" },
            "files": {
              "items": { "$ref": "#/$defs/SnapshotFile" },
              "type": "array"
            },
            "gitRefs": {
              "default": [],
              "items": { "type": "string" },
              "type": "array"
            },
            "head": { "type": "string" },
            "headFingerprint": { "default": "", "type": "string" },
            "id": { "type": "string" },
            "indexFingerprint": { "default": "", "type": "string" },
            "repositoryId": { "type": "string" },
            "request": { "$ref": "#/$defs/CaptureRequest" },
            "sourceIndex": {
              "additionalProperties": { "$ref": "#/$defs/ContentSource" },
              "type": "object"
            },
            "workspaceFingerprint": { "type": "string" }
          },
          "required": [
            "id",
            "repositoryId",
            "createdAt",
            "request",
            "head",
            "workspaceFingerprint",
            "files",
            "changes",
            "sourceIndex"
          ],
          "title": "StoredSnapshot",
          "type": "object"
        },
        "format": { "const": "reviewbox" },
        "id": { "pattern": "^[a-zA-Z0-9_@-]{1,160}$", "type": "string" },
        "kind": { "const": "snapshot" },
        "version": { "const": 3 }
      },
      "required": ["format", "version", "kind", "id", "data"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "documents": {
              "items": { "type": "string" },
              "type": "array",
              "uniqueItems": true
            },
            "language": { "type": "string" },
            "repositoryId": { "type": "string" },
            "revision": { "format": "uint32", "minimum": 0, "type": "integer" },
            "terms": {
              "items": { "type": "string" },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "repositoryId",
            "language",
            "terms",
            "documents",
            "revision"
          ],
          "title": "ProjectKnowledge",
          "type": "object"
        },
        "format": { "const": "reviewbox" },
        "id": { "pattern": "^[a-zA-Z0-9_@-]{1,160}$", "type": "string" },
        "kind": { "const": "knowledge" },
        "version": { "const": 3 }
      },
      "required": ["format", "version", "kind", "id", "data"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "id": { "type": "string" },
            "repositoryId": { "type": "string" },
            "revision": { "format": "uint32", "minimum": 0, "type": "integer" },
            "steps": {
              "items": { "$ref": "#/$defs/OnboardingStep" },
              "type": "array"
            },
            "title": { "type": "string" }
          },
          "required": ["id", "repositoryId", "title", "steps", "revision"],
          "title": "OnboardingTour",
          "type": "object"
        },
        "format": { "const": "reviewbox" },
        "id": { "pattern": "^[a-zA-Z0-9_@-]{1,160}$", "type": "string" },
        "kind": { "const": "onboarding" },
        "version": { "const": 3 }
      },
      "required": ["format", "version", "kind", "id", "data"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "properties": {
            "content": { "$ref": "#/$defs/ProposalContent" },
            "createdAt": { "type": "string" },
            "id": { "type": "string" },
            "reviewId": { "type": "string" },
            "revision": { "format": "uint32", "minimum": 0, "type": "integer" },
            "runId": { "type": ["string", "null"] },
            "snapshotId": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": [
            "id",
            "reviewId",
            "snapshotId",
            "content",
            "status",
            "revision",
            "createdAt"
          ],
          "title": "Proposal",
          "type": "object"
