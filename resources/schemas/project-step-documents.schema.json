{
  "$defs": {
    "DocumentDependencies": {
      "additionalProperties": false,
      "properties": {
        "signature": { "type": "string" },
        "sources": {
          "items": { "$ref": "#/$defs/SourceDescriptor" },
          "type": "array"
        }
      },
      "required": ["signature", "sources"],
      "type": "object"
    },
    "DocumentReference": {
      "additionalProperties": false,
      "properties": {
        "endLine": { "format": "uint32", "minimum": 0, "type": "integer" },
        "explanation": { "type": "string" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "sourceId": { "type": "string" },
        "startLine": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": [
        "id",
        "label",
        "explanation",
        "sourceId",
        "startLine",
        "endLine"
      ],
      "type": "object"
    },
    "DocumentTerm": {
      "additionalProperties": false,
      "properties": {
        "context": { "type": "string" },
        "definition": { "type": "string" },
        "id": { "type": "string" },
        "term": { "type": "string" }
      },
      "required": ["id", "term", "definition", "context"],
      "type": "object"
    },
    "LevelDocuments": {
      "additionalProperties": false,
      "properties": {
        "contextSources": {
          "default": [],
          "items": { "type": "string" },
          "type": "array"
        },
        "dependencies": {
          "anyOf": [
            { "$ref": "#/$defs/DocumentDependencies" },
            { "type": "null" }
          ]
        },
        "essential": { "$ref": "#/$defs/ReviewDocument" },
        "explained": { "$ref": "#/$defs/ReviewDocument" },
        "glossary": {
          "default": [],
          "items": { "$ref": "#/$defs/DocumentTerm" },
          "type": "array"
        },
        "single": {
          "anyOf": [
            { "$ref": "#/$defs/SingleReviewDocument" },
            { "type": "null" }
          ]
        },
        "technical": { "$ref": "#/$defs/ReviewDocument" }
      },
      "type": "object"
    },
    "ReviewDocument": {
      "additionalProperties": false,
      "properties": {
        "body": { "type": "string" },
        "readingSeconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "references": {
          "items": { "$ref": "#/$defs/DocumentReference" },
          "type": "array"
        },
        "termAliases": {
          "additionalProperties": { "type": "string" },
          "default": {},
          "type": "object"
        },
        "terms": {
          "items": { "$ref": "#/$defs/DocumentTerm" },
          "type": "array"
        }
      },
      "required": ["body", "references", "terms", "readingSeconds"],
      "type": "object"
    },
    "ReviewWritingProfile": {
      "additionalProperties": false,
      "properties": {
        "instructions": { "default": "", "type": "string" },
        "style": { "$ref": "#/$defs/ReviewWritingStyle" }
      },
      "required": ["style"],
      "type": "object"
    },
    "ReviewWritingStyle": {
      "enum": ["essential", "explained", "technical", "custom"],
      "type": "string"
    },
    "SingleReviewDocument": {
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/$defs/ReviewDocument" },
        "profile": { "$ref": "#/$defs/ReviewWritingProfile" },
        "version": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": ["version", "profile", "content"],
      "type": "object"
    },
    "SourceDescriptor": {
      "properties": {
        "hash": { "type": "string" },
        "path": { "type": "string" },
        "size": { "format": "uint32", "minimum": 0, "type": "integer" },
        "sourceId": { "type": "string" }
      },
      "required": ["sourceId", "path", "hash", "size"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "documents": {
      "additionalProperties": { "$ref": "#/$defs/LevelDocuments" },
      "type": "object"
    },
    "format": { "const": "reviewbox" },
    "reviewId": { "type": "string" },
    "version": { "const": 4 }
  },
  "required": ["format", "version", "reviewId", "documents"],
  "title": "Pack",
  "type": "object"
}
