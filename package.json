{
  "name": "reviewbox",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run tauri dev",
    "dev:web": "bun run icons:build && bun run workers:build && bun --bun next dev --hostname 127.0.0.1 --port 1420",
    "build": "bun run tauri build",
    "build:web": "bun scripts/build-guard.ts web",
    "build:validation": "bun scripts/build-validation.ts",
    "workers:build": "bun scripts/build-monaco-workers.ts",
    "lint": "bun --bun eslint . --max-warnings 0",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "check": "bun run contracts:check && bun run schemas:check && bun run typecheck && bun run lint && bun run format:check && bun run rust:check",
    "tauri": "bun scripts/build-guard.ts tauri",
    "contracts:generate": "bun scripts/export-contracts.ts",
    "contracts:check": "bun scripts/export-contracts.ts --check",
    "test": "bun test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib",
    "test:web": "bun --bun playwright test",
    "test:native": "bun scripts/test-native.ts",
    "build:native-validation": "bun run tauri build --debug --no-bundle --features native-validation",
    "schemas:generate": "bun scripts/export-project-schemas.ts",
    "schemas:check": "bun scripts/export-project-schemas.ts --check",
    "test:project-cli": "bun scripts/test-project-cli.ts",
    "test:ui:native": "bun scripts/test-ui-native.ts && bun scripts/test-ui-scopes.ts && bun scripts/test-ui-layout.ts && bun scripts/test-ui-settings.ts && bun scripts/test-ui-scroll.ts",
    "test:ui:publication": "bun scripts/test-ui-publication.ts",
    "test:ui:source-control": "bun scripts/test-ui-source-control.ts",
    "test:ui:file-trees": "bun scripts/test-ui-file-trees.ts",
    "test:ui:storage": "bun scripts/test-ui-storage.ts",
    "test:ui:harness-settings": "bun scripts/test-ui-harness-settings.ts",
    "test:ui:models": "bun scripts/test-ui-models.ts",
    "test:ui:selects": "bun scripts/test-ui-selects.ts",
    "test:ui:compatibility": "bun scripts/test-ui-compatibility.ts",
    "test:ui:wizard": "bun scripts/test-ui-wizard.ts",
    "test:ui:read-cache": "bun scripts/test-ui-read-cache.ts",
    "test:ui:preparation": "bun scripts/test-ui-preparation.ts",
    "test:ui:reader": "bun scripts/test-ui-reader.ts",
    "test:ui:references": "bun scripts/test-ui-reader.ts --references-only",
    "test:ui:document-diff": "bun scripts/test-ui-document-diff.ts",
    "test:ui:steps": "bun scripts/test-ui-step-preparation.ts",
    "test:ui:progress": "bun scripts/test-ui-progress.ts",
    "test:ui:rev-menu": "bun scripts/test-ui-rev-menu.ts",
    "test:ui:capture": "bun scripts/test-ui-capture.ts",
    "test:ui:scroll": "bun scripts/test-ui-scroll.ts",
    "test:ui:illustrations": "bun scripts/test-ui-illustrations.ts",
    "test:ui:wrap": "bun scripts/test-ui-wrap.ts",
    "test:ui:overlays": "bun scripts/test-ui-overlays.ts",
    "test:ui:editor-overlays": "bun scripts/test-ui-editor-overlays.ts",
    "icons:build": "bun scripts/build-file-icons.ts",
    "test:ui:languages": "bun scripts/test-ui-languages.ts",
    "test:ui:code-colors": "bun scripts/test-ui-code-colors.ts",
    "test:ui:block-diff": "bun scripts/test-ui-block-diff.ts",
    "app-icons:build": "bun scripts/build-app-icons.ts",
    "build:storage": "bun scripts/build-guard.ts report",
    "build:clean": "bun scripts/build-guard.ts clean",
    "test:build-storage": "bun test ./scripts/build-storage.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/monaco": "4.4.3",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "chroma-js": "3.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "diff": "8.0.4",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "input-otp": "^1.5.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "0.56.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shadcn": "^4.21.0",
    "shiki": "4.4.3",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "^1.4.2",
    "@types/chroma-js": "3.1.2",
    "@types/hast": "3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "material-icon-theme": "5.38.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
